<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.carlostorres.weatherapppositivo.presentation.MainViewModel" />
    </data>

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".ui.MainActivity">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8.dp"
                android:orientation="vertical"
                android:layout_weight="1">

                <androidx.cardview.widget.CardView
                    android:id="@+id/til_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <fragment
                        android:id="@+id/fragmentPlace"
                        android:name="com.google.android.libraries.places.widget.AutocompleteSupportFragment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </androidx.cardview.widget.CardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_centerInParent="true"
                    app:layout_constraintTop_toBottomOf="@id/til_search"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp"
                    app:strokeWidth="2dp"
                    app:cardBackgroundColor="@color/white">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/card_bg"
                        android:padding="12dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cl_weatherInfo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:weather="@{viewModel.weather}"
                            app:isLoading="@{viewModel.isLoading}"
                            >

                            <androidx.constraintlayout.widget.Guideline
                                android:id="@+id/guideline2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                app:layout_constraintGuide_percent="0.5" />

                            <TextView
                                android:id="@+id/tv_weatherPlace"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:setWeatherPlaceText="@{viewModel.weather}"
                                tools:text="NEZA"
                                android:textSize="20sp"
                                android:textStyle="bold|italic"
                                android:textColor="@color/black"/>

                            <ImageView
                                android:id="@+id/iv_weather"
                                android:layout_width="100dp"
                                android:layout_height="0dp"
                                app:weatherIcon='@{viewModel.weather}'
                                app:layout_constraintTop_toBottomOf="@id/tv_weatherPlace"
                                app:layout_constraintBottom_toTopOf="@id/guideline2"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/tv_temperature"
                                android:scaleType="fitCenter"
                                tools:src="@drawable/sunny"/>

                            <TextView
                                android:id="@+id/tv_temperature"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="20°"
                                android:textSize="40sp"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                app:weatherTemperature="@{viewModel.weather}"
                                app:layout_constraintStart_toEndOf="@id/iv_weather"
                                app:layout_constraintBottom_toBottomOf="@id/iv_weather"
                                app:layout_constraintTop_toTopOf="@id/iv_weather"
                                app:layout_constraintEnd_toEndOf="parent"
                                />

                            <TextView
                                android:id="@+id/tv_weatherInfo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Soleado"
                                app:layout_constraintTop_toBottomOf="@id/tv_temperature"
                                app:layout_constraintStart_toEndOf="@id/iv_weather"
                                app:layout_constraintEnd_toEndOf="parent"
                                android:textSize="12sp"
                                app:weatherDescription="@{viewModel.weather}"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/guideline2"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center_horizontal">

                                    <ImageView
                                        android:layout_width="40dp"
                                        android:layout_height="0dp"
                                        android:layout_weight="2"
                                        android:src="@drawable/rain"/>

                                    <TextView
                                        android:id="@+id/tv_rain"
                                        android:layout_width="wrap_content"
                                        android:layout_height="0dp"
                                        android:layout_weight="1"
                                        app:rainPercentage="@{viewModel.weather}"
                                        tools:text="22%"
                                        />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="0dp"
                                        android:layout_weight="1"
                                        android:text="LLuvia"
                                        />

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center_horizontal">

                                    <ImageView
                                        android:layout_width="40dp"
                                        android:layout_height="0dp"
                                        android:layout_weight="2"
                                        android:src="@drawable/wind"/>

                                    <TextView
                                        android:id="@+id/tv_wind"
                                        android:layout_width="wrap_content"
                                        android:layout_height="0dp"
                                        android:layout_weight="1"
                                        app:windSpeed="@{viewModel.weather}"
                                        tools:text="22%"
                                        />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="0dp"
                                        android:layout_weight="1"
                                        android:text="Viento"
                                        />

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center_horizontal">

                                    <ImageView
                                        android:layout_width="40dp"
                                        android:layout_height="0dp"
                                        android:layout_weight="2"
                                        android:src="@drawable/humidity"/>

                                    <TextView
                                        android:id="@+id/tv_humidity"
                                        android:layout_width="wrap_content"
                                        android:layout_height="0dp"
                                        android:layout_weight="1"
                                        tools:text="22%"
                                        app:humidity="@{viewModel.weather}"
                                        />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="0dp"
                                        android:layout_weight="1"
                                        android:text="Humedad"
                                        />

                                </LinearLayout>

                            </LinearLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            android:id="@+id/tv_searchMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/search_text"
                            app:weather="@{viewModel.weather}"
                            app:isLoading="@{viewModel.isLoading}"
                            android:layout_centerInParent="true"/>

                        <ProgressBar
                            android:id="@+id/pbLoading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_centerInParent="true"
                            app:isVisible="@{viewModel.isLoading}"/>

                    </RelativeLayout>


                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>



        <fragment
            android:id="@+id/fragmentMap"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</layout>